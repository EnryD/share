{% extends 'base.html.twig' %}

{% block title %}{{parent()}}Contact{% endblock %}

{% block body %}
<h1 class="text-center text-primary mt-4 pt-4 display-3 fw-bold">Contact</h1>
<h2 class="text-center text-secondary mb-4 pb-4">Une question ? Écrivez-nous</h2>

<div class="container mb-5" style="max-width: 700px;">

    {% if nom %}
    <div class="alert alert-success text-center">
        <i class="bi bi-check-circle"></i> Merci {{ nom }}, votre message a bien été reçu !
    </div>
    {% endif %}

    <div class="card border-primary">
        <div class="card-header"><i class="bi bi-envelope"></i> Formulaire de contact</div>
        <div class="card-body">
            <form method="post" action="{{path('app_contact')}}">

                <div class="mb-3">
                    <label for="nom" class="form-label">Nom</label>
                    <input type="text" class="form-control" id="nom" name="nom" placeholder="Votre nom" required>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">E-mail</label>
                    <input type="email" class="form-control" id="email" name="email" placeholder="nom@exemple.fr" required>
                </div>

                <div class="mb-3">
                    <label for="sujet" class="form-label">Sujet</label>
                    <select class="form-select" id="sujet" name="sujet">
                        <option>Question</option>
                        <option>Problème avec un fichier</option>
                        <option>Autre</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="message" class="form-label">Message</label>
                    <textarea class="form-control" id="message" name="message" rows="5" placeholder="Votre message..." required></textarea>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="accord" name="accord" required>
                    <label class="form-check-label" for="accord">
                        J'accepte que mes informations servent uniquement à me répondre
                        (voir les <a href="{{path('app_mentions_legales')}}">mentions légales</a>).
                    </label>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Envoyer</button>
                </div>

            </form>
        </div>
    </div>
</div>
{% endblock %}
