{% extends 'base.html.twig' %}

{% block title %}{{parent()}}Liste des utilisateurs{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-10 text-primary">
            <h1 class="text-center text-primary mt-4 pt-4 display-3 fw-bold">Liste des utilisateurs</h1>
            <h2 class="text-center text-secondary mb-4 pb-4">Du plus récent au plus ancien</h2>
            <div class="row justify-content-center">
                <div class="col-12 col-md-8 p-4 m-0 text-primary">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">Adresse e-mail</th>
                                    <th scope="col">Date d'inscription</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for utilisateur in utilisateurs %}
                                <tr class="{{ cycle(['table-primary', 'table-secondary'], loop.index0) }}">
                                    <td>{{ utilisateur.email }}</td>
                                    <td>
                                        {% if utilisateur.dateInscription %}
                                            {{ utilisateur.dateInscription | date('d/m/Y H:i') }}
                                        {% else %}
                                            Non renseignée
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
