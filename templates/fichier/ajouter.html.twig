{% extends 'base.html.twig' %}

{% block title %}Ajouter un fichier - {{ parent() }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-10">
            <h1 class="text-primary">Ajouter un fichier</h1>
            <p>Choisissez un fichier sur votre ordinateur : il sera envoyé dans le dossier public/fichiers du serveur.</p>
            <p>Types acceptés : pdf, txt, doc, docx, odt, png, jpg (2 Mo maximum).</p>
            <p>Pas de catégorie dans la liste ? <a href="{{ path('app_categories') }}">Créer une catégorie</a></p>
            {{ form(form) }}
            <a href="{{ path('app_bibliotheque') }}">Retour à la bibliothèque</a>
        </div>
    </div>
</div>
{% endblock %}
