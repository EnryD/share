{% extends 'base.html.twig' %}

{% block title %}Bibliothèque - {{ parent() }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-10">
            <h1 class="text-primary">Bibliothèque</h1>
            <a class="btn btn-primary" href="{{ path('app_fichier_ajouter') }}">Ajouter un fichier</a>
            <div>
                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_bibliotheque') }}">Toutes</a>
                {% for categorie in categories %}
                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_bibliotheque_categorie', {id: categorie.id}) }}">{{ categorie.nom }}</a>
                {% endfor %}
            </div>
            {% if categorieActive %}
            <h2>Catégorie : {{ categorieActive.nom }}</h2>
            {% endif %}
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Catégorie</th>
                        <th>Fichier</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for fichier in fichiers %}
                    <tr>
                        <td>{{ fichier.nom }}</td>
                        <td><span class="badge bg-secondary">{{ fichier.categorie.nom }}</span></td>
                        <td>{{ fichier.nomFichier }}</td>
                        <td><a class="btn btn-sm btn-outline-primary" href="{{ app.request.basePath }}/fichiers/{{ fichier.nomFichier }}" download>Télécharger</a></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
